# Local tuning file for docker compose (git-ignored; see .env.example).
# 2x RTX 3090 setup: tensor-parallel across both cards.

# Speed-first single-user defaults (README "If you are the only user").
SPEC=dflash2
PREFIX_CACHE=1

CTX=huge
MAX_LEN=262144

# TP=2: the second card is a second memory system, +16-35% decode vs one card
# (issue #40 A/B). The single-user launcher parses this out of EXTRA_ARGS and
# automatically drops the single-card KV_MEM pin (it would strand ~16 GiB
# per worker); the KV pool is sized from GPU_UTIL instead.
EXTRA_ARGS=--tensor-parallel-size 2

# WSL2 only (no-op on native Linux): SPEC=dflash2 forces the V2 runner, whose
# UVA buffers are refused on WSL2 without this.
VLLM_WSL2_ENABLE_PIN_MEMORY=1

# Keep the default verify-block width 7 for the 2-GPU run. Do NOT enable
# DFLASH_TOKENS=15 here: the one measured TP=2 datapoint at 15 lost 27% at C1
# (README "More than one GPU"; the launcher warns if you set it).

# VLLM_API_KEY=
# The server binds 0.0.0.0 and has no authentication without one.
#   echo "VLLM_API_KEY=$(openssl rand -hex 24)" >> .env
