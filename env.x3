# Local tuning file for docker compose (git-ignored; see .env.example).
# 3x RTX 3090 layout:
#   GPU 0+1  ->  "single"  TP=2 engine on port 18020  (docker compose --profile single --profile solo up -d)
#   GPU 2    ->  "solo"    standalone TP=1 engine on SOLO_PORT
#
# Why not one engine on all three: this model's target has 4 KV heads and the
# DFlash2 drafter 8; TP=3 needs heads % 3 == 0 (or 3 dividing the head count),
# so vLLM rejects it, and PP=3 can't split the 64 layers evenly. Two TP=2
# engines are impossible (only two cards' worth of pairs). Three standalone
# engines would work but each would be as slow as a single card — the
# measured split here keeps the +16-35% TP=2 path (#40) for the main engine.

# Speed-first single-user defaults (README "If you are the only user").
SPEC=dflash2
PREFIX_CACHE=1

CTX=huge
MAX_LEN=262144

# Main engine (service "single", GPUs 0+1): tensor-parallel across the pair.
# The single-user launcher parses this out of EXTRA_ARGS and automatically
# drops the single-card KV_MEM pin (per-worker it would strand ~16 GiB); the
# KV pool is sized from GPU_UTIL instead.
EXTRA_ARGS=--tensor-parallel-size 2


# If this box has more than two GPUs, pin the two you want in
# docker-compose.yml instead of count: 2:
#   device_ids: ['0', '1']

# When the box has more than two GPUs, you shall pin the two you want in
# docker-compose.yml instead of count: 2:
CUDA_VISIBLE_DEVICES=0,1
GPU_COUNT=all

# Second engine (service "solo", GPU 2): same launcher, one card.
# Its port comes from SOLO_PORT below; the service clears EXTRA_ARGS so
# this flag must NOT apply to it (see docker-compose.yml, "solo").
SOLO_PORT=18021

# Required with two serve containers on one host: both launchers share the
# host /dev/shm (ipc: host) and each one's stale-offload-region reaper can
# only see its own container's processes — left enabled, "solo"'s boot scan
# would delete the live "single" engine's offload region (issue #33).
VLLM_OFFLOAD_KEEP_SHM=1

# WSL2 only (no-op on native Linux): SPEC=dflash2 forces the V2 runner, whose
# UVA buffers are refused on WSL2 without this.
VLLM_WSL2_ENABLE_PIN_MEMORY=1

# Keep the default verify-block width 7 for the TP=2 engine: the one measured
# TP=2 datapoint at DFLASH_TOKENS=15 lost 27% at C1 (README "More than one
# GPU"; the launcher warns if you set it anyway).

# VLLM_API_KEY=
# Both servers bind 0.0.0.0 and have no authentication without one.
#   echo "VLLM_API_KEY=$(openssl rand -hex 24)" >> .env

